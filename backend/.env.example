# Optional server-side defaults for local/standalone use.
#
# The web app does NOT require this file: users supply their model and API keys
# in the interface (Edit > Edit API Keys), and the frontend forwards them with
# each request via the X-LLM-Config header. Keys set here act only as fallback
# defaults, e.g. when running backend modules directly.

# LiteLLM model string, e.g. "openai/gpt-4.1", "azure/<deployment>", "anthropic/claude-sonnet-4-5"
# Bare names without a provider prefix are treated as Azure deployments.
MODEL=

# Provider credentials (set the ones matching your MODEL provider)
OPENAI_API_KEY=
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=
# ANTHROPIC_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION_NAME=

# Optional embedding model (LiteLLM string) and endpoint
# EMBEDDING_MODEL=
# EMBEDDING_AZURE_ENDPOINT=

# Rate-limit tuning (all optional)
# LLM_CALL_DELAY=0          # seconds to sleep before each LLM call
# LLM_MAX_RETRIES=5         # retries on 429 rate-limit errors
# LLM_RETRY_BASE_DELAY=2    # base for exponential backoff (seconds)
